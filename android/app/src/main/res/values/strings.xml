    <string name="about_tagline">Zero-Internet Offline-First Gamified Learning Platform for Rural Karnataka</string>
    <string name="academic_institution">Academic Institution</string>
    <string name="college_name">Don Bosco Institute of Technology, Bangalore</string>
    <string name="autonomous_tag">An Autonomous Institute Affiliated to VTU, Belagavi</string>
    <string name="problem_statement">The Problem in Rural Karnataka</string>
    <string name="problem_desc">Over 64% of rural students in Karnataka face intermittent grid power, exorbitant mobile data recharges (₹299/mo), and utilize hand-me-down budget Android smartphones (2GB-3GB RAM) with slow storage. Cloud-based video learning fails completely in these conditions.</string>
    <string name="solution_title">Our Autonomous Offline-First Architecture</string>
    <string name="solution_desc">Nanna Shikshana replaces heavy video streaming with ultralight &lt;1.5MB vector modules, client-side Room SQLite persistence, and local Wi-Fi Direct mesh distribution. Zero internet required.</string>
